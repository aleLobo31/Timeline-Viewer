# Copy to apps/api/.env
DATABASE_URL="postgresql://timeline:timeline@localhost:5432/timeline?schema=public"
TEST_DATABASE_URL="postgresql://timeline:timeline@localhost:5432/timeline_test?schema=public"
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET="COMPLETARE_CON_LA_SECRET_DE_JWT"
PORT=4000
# Origin of the web app (CORS + public share URLs). Must be https://
WEB_ORIGIN="https://localhost:5173"
# The API only serves HTTPS. Generate these files with `npm run certs` (mkcert)
TLS_KEY_FILE="../../certs/localhost-key.pem"
TLS_CERT_FILE="../../certs/localhost.pem"
UPLOAD_DIR="./uploads"
NODE_ENV=development

# --- Production behind Caddy on the same machine (see deploy/ and README "Deployment") ---
# NODE_ENV=production
# WEB_ORIGIN="https://timeline-viewer.duckdns.org"  # not the EC2 *.amazonaws.com name (Let's Encrypt rejects it)
# DATABASE_URL must contain the user, password and host literally. Node does not expand
# ${DATABASE_PWD} or ${HOST} in .env files, so a URL like postgresql://timeline:${DATABASE_PWD}@...
# would try to log in with the characters "${DATABASE_PWD}" and every request would 500.
# DATABASE_URL="postgresql://USER:STRONG_PASSWORD@127.0.0.1:5432/timeline?schema=public"
# HOST below is the listen address (write 127.0.0.1, not ${HOST}):
# TLS_KEY_FILE="/etc/timeline/api-key.pem"      # internal self-signed pair, see README
# TLS_CERT_FILE="/etc/timeline/api-cert.pem"
# UPLOAD_DIR="/var/lib/timeline/uploads"
# Listen on loopback only, so the proxy is the only way in:
# HOST=127.0.0.1
# Believe X-Forwarded-For from the proxy only (never `true`); keeps one rate limit per client:
# TRUST_PROXY=loopback
