[Unit]
Description=Timeline Viewer API (HTTPS, behind Caddy)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=timeline
Group=timeline
WorkingDirectory=/opt/Timeline-Viewer/apps/api
Environment=HOME=/var/lib/timeline
Environment=NODE_ENV=production
# tsx is hoisted to the workspace root. Calling it through node avoids npm writing a cache
# under ProtectSystem=strict. Reads apps/api/.env (HOST=127.0.0.1, TRUST_PROXY=loopback, ...).
ExecStart=/usr/bin/node /opt/Timeline-Viewer/node_modules/tsx/dist/cli.mjs --env-file-if-exists=.env src/index.ts
Restart=on-failure
RestartSec=3

# Hardening: the API only needs to write its uploads.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/timeline

[Install]
WantedBy=multi-user.target
